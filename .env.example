# ===== 服务配置 =====
# 监听端口（阿里云安全组需放行该端口；生产建议用 80/443 经 nginx 反代）
PORT=3000

# ===== 管理员鉴权 =====
# 管理员登录密码（请改成强密码）
ADMIN_PASSWORD=change_me_strong_password
# JWT 签名密钥（请改成一段随机长字符串，例如 openssl rand -hex 32）
JWT_SECRET=please_change_this_to_a_long_random_secret

# ===== 数据抓取源（可选，留空则用默认值）=====
# 莱斯特城官网阵容页
LCFC_SQUAD_URL=https://www.lcfc.com/teams/men
# 懂球帝莱斯特城阵容页
DONGQIUDI_SQUAD_URL=https://www.dongqiudi.com/data/team/2
